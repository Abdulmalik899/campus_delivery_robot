<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  
 
 
  <xacro:property name="camera_radius" value="0.015"/>
  <xacro:property name="cam_z_padding" value="0.05"/>
  <xacro:property name="camera_length" value="0.006"/>
  <xacro:property name="cam_z_elevation" value="${base_height + hatch_main_base_height*1.5}"/>
   
   
  <xacro:macro name="cam_face" params="prefix">

    <link name="camera_link">
  <visual>
    <geometry>
      <cylinder radius="${camera_radius}" length="${camera_length}"/>
    </geometry>
    <origin xyz="${camera_length/2} 0 0" rpy="0 ${pi/2} 0"/>
    <material name="black"/>
  </visual>
  <collision>
    <geometry>
      <cylinder radius="${camera_radius}" length="${camera_length}"/>
    </geometry>
    <origin xyz="${camera_length/2} 0 0" rpy="0 ${pi/2} 0"/>
  </collision>
</link>

<joint name="camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz="${base_length/2} 0 ${cam_z_elevation}" rpy="0 0 0"/>
</joint>

  </xacro:macro>

</robot>

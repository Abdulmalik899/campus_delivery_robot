<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
<!-- FRICTION: The wheels grip, the castors slide. -->
<gazebo reference="left_wheel_link">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>
<gazebo reference="right_wheel_link">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>
<gazebo reference="front_castor_wheel_link">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>
<gazebo reference="rear_castor_wheel_link">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<gazebo>
   <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
  <!-- Turns /cmd_vel into wheel speeds, and works out /odom from how far the wheels turned. -->
   <left_joint>base_left_wheel_joint</left_joint>
   <right_joint>base_right_wheel_joint</right_joint>
   <wheel_separation>${base_width + wheel_length}</wheel_separation>
    <wheel_radius>${wheel_radius}</wheel_radius>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <tf_topic>model/campus_delivery_robot/tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_floor</child_frame_id>
    <odom_publish_frequency>30</odom_publish_frequency>
   </plugin>
   
   <plugin filename="gz-sim-joint-state-publisher-system" 
           name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
   </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
    <joint_name>below_hatch_door_joint</joint_name>
    <topic>below_hatch_door/cmd_pos</topic>
    <p_gain>10</p_gain>
    <d_gain>0.5</d_gain>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
    <joint_name>above_hatch_door_joint</joint_name>
    <topic>above_hatch_door/cmd_pos</topic>
    <p_gain>10</p_gain>
    <d_gain>0.5</d_gain>
  </plugin>
</gazebo>



<gazebo reference="lidar_sensor_link">
  <sensor name="lidar" type="gpu_lidar">
    <gz_frame_id>lidar_link</gz_frame_id>
    <topic>scan</topic>
    <pose>0 0 ${lidar_height/2} 0 0 0</pose>
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <min_angle>${-pi}</min_angle>
          <max_angle>${pi}</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.35</min>
        <max>15.0</max>
      </range>
    </lidar>
  </sensor>
</gazebo>


<gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <always_on>true</always_on>
    <update_rate>20</update_rate>
    <topic>camera/image_raw</topic>
    <gz_frame_id>camera_link</gz_frame_id>
    <camera>
      <horizontal_fov>1.2</horizontal_fov>
      <image><width>640</width><height>480</height></image>
      <clip><near>0.05</near><far>20</far></clip>
    </camera>
  </sensor>
</gazebo>







</robot>
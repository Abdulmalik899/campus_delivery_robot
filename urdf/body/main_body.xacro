<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
   <xacro:property name="hatch_main_base_length" value="0.2"/>
   <xacro:property name="main_base_height" value="0.25"/>
   <xacro:property name="hatch_main_base_width" value="0.2"/>
   <xacro:property name="hatch_main_base_height" value="${main_base_height/2}"/> 
   <xacro:property name="door_t" value="0.004"/>
   
   

  <xacro:macro name="main_body_below_hatch" params="prefix">
    <link name="main_body_below_hatch_link"> 
     <visual>
       <geometry>
         <box size="${hatch_main_base_length} ${hatch_main_base_width} ${hatch_main_base_height}"/>
       </geometry>
       <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green"/>
     </visual>
     <collision>
       <geometry>
         <box size="${hatch_main_base_length} ${hatch_main_base_width} ${hatch_main_base_height}"/>
       </geometry>
       <origin xyz="0 0 0" rpy="0 0 0"/>
     </collision>
    </link>

     <joint name="base_main_body_below_hatch_joint" type="fixed">
  <parent link="base_link"/>
  <child  link="main_body_below_hatch_link"/>
  <origin xyz="0 0 ${hatch_main_base_height/2 + base_height}" rpy="0 0 0"/>
</joint>
</xacro:macro>

<xacro:macro name="below_hatch_door" params="prefix">
  <link name="below_hatch_door_link">
    <visual>
      <origin xyz="${door_t/2} ${-hatch_main_base_width/2} 0" rpy="0 0 0"/>
      <geometry>
      <box size="${door_t} ${hatch_main_base_width} ${hatch_main_base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${door_t/2} ${-hatch_main_base_width/2} 0" rpy="0 0 0"/>
      <geometry>
      <box size="${door_t} ${hatch_main_base_width} ${hatch_main_base_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="below_hatch_door_joint" type="revolute">
    <parent link="main_body_below_hatch_link"/>
    <child  link="below_hatch_door_link"/>
    <origin xyz="${hatch_main_base_length/2} ${hatch_main_base_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="5.0" velocity="1.0"/>
  </joint>
</xacro:macro>


  <xacro:macro name="main_body_above_hatch" params="prefix">
    <link name="main_body_above_hatch_link"> 
     <visual>
       <geometry>
         <box size="${hatch_main_base_length} ${hatch_main_base_width} ${hatch_main_base_height}"/>
       </geometry>
       <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="yellow"/>
     </visual>
     <collision>
       <geometry>
         <box size="${hatch_main_base_length} ${hatch_main_base_width} ${hatch_main_base_height}"/>
       </geometry>
       <origin xyz="0 0 0" rpy="0 0 0"/>
     </collision>
    </link>


    <joint name="base_main_body_above_hatch_joint" type="fixed">
  <parent link="main_body_below_hatch_link"/>
  <child  link="main_body_above_hatch_link"/>
  <origin xyz="0 0 ${hatch_main_base_height}" rpy="0 0 0"/>
</joint>
</xacro:macro>

<xacro:macro name="above_hatch_door" params="prefix">
  <link name="above_hatch_door_link">
    <visual>
      <origin xyz="${-hatch_main_base_length/2} ${door_t/2} 0" rpy="0 0 0"/>
      <geometry>
      <box size="${hatch_main_base_length} ${door_t} ${hatch_main_base_height}"/>
      </geometry>
     <material name="red"/>
    </visual>
    <collision>
      <origin xyz="${-hatch_main_base_length/2} ${door_t/2} 0" rpy="0 0 0"/>
      <geometry>
      <box size="${hatch_main_base_length} ${door_t} ${hatch_main_base_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="above_hatch_door_joint" type="revolute">
    <parent link="main_body_above_hatch_link"/>
    <child  link="above_hatch_door_link"/>
    <origin xyz="${hatch_main_base_length/2} ${hatch_main_base_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.57" effort="5.0" velocity="1.0"/>
  </joint>
</xacro:macro>

</robot>
<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
   <xacro:property name="main_base_length" value="0.9"/>
   <xacro:property name="lidar_space" value="0.1"/>
   <xacro:property name="main_base_width" value="0.6"/>
   <xacro:property name="main_base_height" value="0.8"/> 
   <xacro:property name="lid_thickness" value="0.1"/>
   <xacro:property name="lid_length" value="${main_base_length - lidar_space}"/>

    <xacro:macro name="bot_lid" params="prefix">
      <link name="top_lid_link">
        <visual>
          <geometry>
              <box size="${lid_length} ${main_base_width} ${lid_thickness}"/>        
          </geometry>
             <origin xyz="${lid_length/2} 0 0 " rpy="0 0 0"/>
             <material name="green"/>
        </visual>
        <collision>
           <geometry>
              <box size="${lid_length} ${main_base_width} ${lid_thickness}"/>        
          </geometry>
             <origin xyz="${lid_length/2} 0 0 " rpy="0 0 0"/>
        </collision>
      </link>
      <joint name="bot_lid_joint" type="revolute">
      <parent link="base_link"/>
      <child link="top_lid_link"/>
      <origin xyz="${-main_base_length/2} 0 ${main_base_height + base_height + lid_thickness/2}" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="${pi}" effort="1.0" velocity="1.0"/>
      </joint>
    </xacro:macro>

   <xacro:macro name="main_body" params="prefix">
       <link name="main_body_link"> 
         <visual>
            <geometry>
             <box size="${main_base_length} ${main_base_width} ${main_base_height}"/>
            </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>
              <material name="grey"/>
         </visual>
         <collision>
            <geometry>
             <box size="${main_base_length} ${main_base_width} ${main_base_height}"/>
            </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>         
         </collision>
       </link>

       <joint name="base_main_body_joint" type="fixed">
       <parent link="base_link"/>
       <child link="main_body_link"/>
       <origin xyz="0 0 ${main_base_height/2 + base_height} " rpy="0 0 0"/>
       </joint>
   </xacro:macro>
</robot>
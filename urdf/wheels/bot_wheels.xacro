<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:property name="wheel_radius" value="0.2"/>
   <xacro:property name="wheel_length" value="0.1"/>
   <xacro:property name="castor_radius" value="0.05"/>
   <xacro:property name="castor_xoff" value="0.35"/>


   <xacro:macro name="bot_wheel" params="prefix reflect">
     <link name="${prefix}wheel_link">
       <visual>
       <geometry>
           <cylinder radius="${wheel_radius}" length="${wheel_length}"/>       
       </geometry>
         <origin xyz="0 ${reflect*wheel_length/2} 0" rpy="${pi/2} 0 0"/>
       <material name="red"/>
       </visual>
       <collision>
          <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
          </geometry>
          <origin xyz="0 ${reflect*wheel_length/2} 0" rpy="${pi/2} 0 0"/>
       </collision> 
     </link>
     <joint name="base_${prefix}wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${prefix}wheel_link"/>
        <origin xyz="0 ${reflect* base_width/2} ${ground_clearance}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
     </joint>
   </xacro:macro>

   <xacro:macro name="bot_castor" params="prefix reflect">
     <link name="${prefix}castor_wheel_link">
     <visual>
       <geometry>
         <sphere radius="${castor_radius}"/>
       </geometry>
       <origin xyz="0 0 ${-castor_radius} " rpy="0 0 0 "  />
       <material name="blue"/>
     </visual>
     <collision>
       <geometry>
         <sphere radius="${castor_radius}"/>
       </geometry>
       <origin xyz="0 0 ${-castor_radius} " rpy="0 0 0 "  />
     </collision>
    </link>           

    <joint name="${prefix}castor_wheel_joint" type="fixed">
     <parent link="base_link"/>
     <child link="${prefix}castor_wheel_link"/>
     <origin xyz="${reflect*castor_xoff} 0 0" rpy="0 0 0"/>
     </joint>
   
   </xacro:macro>



</robot>